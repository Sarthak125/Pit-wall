# Optional: sign-in and settings sync with Supabase. Copy to .env.local and fill in from your Supabase project
# (Project Settings > API). Leave empty to build without sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Extra sign-in buttons, comma separated: github, google (each must be turned on in Supabase > Authentication > Providers).
VITE_SUPABASE_PROVIDERS=
